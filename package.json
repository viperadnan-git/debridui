{
    "name": "debridui",
    "version": "0.1.0",
    "private": true,
    "license": "GPL-3.0-or-later",
    "author": "Adnan Ahmad <viperadnan@gmail.com>",
    "description": "A modern debrid client with built-in media discovery and streaming.",
    "keywords": [
        "debrid",
        "client",
        "nextjs",
        "tailwindcss",
        "typescript"
    ],
    "homepage": "https://debridui.viperadnan.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/viperadnan-git/debridui"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "node .next/standalone/server.js",
        "postbuild": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
        "lint": "biome lint",
        "lint:fix": "biome lint --write",
        "format": "biome format --write",
        "format:check": "biome format",
        "check": "biome check",
        "check:fix": "biome check --write",
        "typecheck": "tsc --noEmit",
        "verify": "bun run typecheck && bun run check",
        "update": "bunx next upgrade && bun update",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@bprogress/next": "^3.2.12",
        "@hookform/resolvers": "^7.0.8",
        "@tanstack/react-query": "^5.108.2",
        "@tanstack/react-query-persist-client": "^5.108.2",
        "better-auth": "^1.7.27",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.4",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-react": "^8.6.0",
        "embla-carousel-wheel-gestures": "^8.1.0",
        "fuse.js": "^7.5.0",
        "idb-keyval": "^6.3.0",
        "lucide-react": "^1.77.0",
        "next": "16.4.6",
        "next-themes": "^0.4.6",
        "postgres": "^4.1.1",
        "radix-ui": "^1.8.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-dropzone": "^20.2.1",
        "react-hook-form": "^7.92.0",
        "react-window": "^2.5.3",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.1",
        "uuid": "^14.0.3",
        "vaul": "^1.1.2",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/react-window": "^2.0.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "^0.31.11",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2"
    },
    "nizm": {
        "hooks": {
            "biome": {
                "cmd": "bunx biome check --write --no-errors-on-unmatched {staged_files}"
            },
            "lint": {
                "cmd": "bun run lint"
            }
        }
    }
}
