{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!.next", "!out", "!build", "!next-env.d.ts", "!drizzle"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120,
        "bracketSameLine": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "performance": {
                "noImgElement": "off"
            },
            "security": {
                "noDangerouslySetInnerHtml": "off"
            },
            "style": {
                "noNonNullAssertion": "off"
            },
            "suspicious": {
                "noShadowRestrictedNames": "off"
            },
            "a11y": {
                "useKeyWithClickEvents": "off"
            }
        }
    },
    "css": { "parser": { "tailwindDirectives": true } },
    "javascript": {
        "formatter": {
            "jsxQuoteStyle": "double",
            "quoteStyle": "double",
            "trailingCommas": "es5",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSameLine": true,
            "bracketSpacing": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": { "source": { "organizeImports": "on" } }
    }
}
